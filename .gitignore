# ------------------------------
# PYTHON
# ------------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
.venv/
venv/
.env
.env.*
*.egg-info/
dist/
build/

# ------------------------------
# NOTEBOOK / VS CODE
# ------------------------------
.ipynb_checkpoints/
.vscode/
*.code-workspace

# ------------------------------
# LOGS & TEMP
# ------------------------------
logs/
*.log
tmp/
.cache/
.DS_Store
Thumbs.db

# ------------------------------
# JAVA
# ------------------------------
target/
*.class
*.jar
*.war
*.ear
.gradle/
.gradle-cache/
out/

# ------------------------------
# RUST
# ------------------------------
target/
Cargo.lock
# (Uncomment if you need to keep Cargo.lock for binaries)
# !Cargo.lock

# ------------------------------
# NODE
# ------------------------------
node_modules/

# ------------------------------
# DATASETS (VERY IMPORTANT)
# Ignore ALL data folders except schema files
# ------------------------------
data/
!data/README.md
# if you want to keep sample small files:
!data/samples/
!data/samples/*

# ------------------------------
# MODEL FILES / WEIGHTS
# ------------------------------
models/
!models/templates/
*.safetensors
*.pt
*.bin
*.onnx
*.tar
*.tar.gz
*.zip

# ------------------------------
# RETRIEVAL, RAG, BM25 CACHES
# ------------------------------
retrieve/bm25_cache.json
retrieve/bm25_cache_java2rust.json
retrieve/bm25_cache_java_rust.json
retrieve/**/*.png
retrieve/**/*.json

# ------------------------------
# OUTPUTS / RESULTS
# ------------------------------
outputs/
outputs_v100/
outputs_whole/
results/
runs/
artifacts/
checkpoints/

# Keep summaries if needed:
!results/**/*.csv
!results/**/*.md

# ------------------------------
# EXECUTION ENGINE (temporary)
# ------------------------------
ExecEval-main/execution_engine/test_codes/
ExecEval-main/eval_scripts/__pycache__/
ExecEval-main/**/__pycache__/

# ------------------------------
# LARGE FILE BLOCKERS
# ------------------------------
*.safetensors
*.bin
*.pt
*.h5

# ------------------------------
# PROJECT SPECIFIC IGNORES
# ------------------------------
# Ignore VLLM logs, caches, dumps
vllm_*
dump_*
scheduler_*

# Ignore raw retrieval dumps
data/retrieval/raw/
data/retrieval/processed/
!data/retrieval/scripts/

# Keep all scripts, configs, prompts
!scripts/
!baselines/
!configs/
!prompts/
!src/

# Keep documentation
!README.md
!docs/
